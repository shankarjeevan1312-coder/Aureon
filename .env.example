# ===================================================
# AUREON Autonomous Local Voice & System Assistant
# Environment Configuration
# ===================================================

# NVIDIA Nemotron API (build.nvidia.com)
# Free tier: 40 RPM, no token exhaustion
NVIDIA_API_KEY=nvapi-your-key-here
NEMOTRON_MODEL=nvidia/nemotron-3-8b-chat
# Alternative models: nvidia/nemotron-3.5-lightning, nvidia/nemotron-3-ultra-550b

# Fallback: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Server Host and Port
AUREON_HOST=0.0.0.0
AUREON_PORT=8000

# Edge TTS Voice Settings
# Examples: en-US-GuyNeural (male, composed), en-US-AriaNeural (female), en-GB-RyanNeural
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Safe Mode / Confirmation Setting
# When true, destructive actions (file delete, kill process, shutdown) require explicit user approval
REQUIRE_DESTRUCTIVE_CONFIRMATION=true
